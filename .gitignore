# 数据目录：样本和报告绝不应进版本库
data/
*.db

# ClamAV 便携版（含签名库约 700 MB，用 setup-clamav 重新获取）
tools/

# 前端截图产物
frontend/_shots/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 前端
node_modules/
.vite/

# 注意：frontend/dist/ **故意不忽略**。
# 构建产物随仓库提交，使用者就不需要 Node.js 工具链。
# 改了 frontend/src/ 之后请执行 `npm run build` 并提交产物，
# 否则仓库里的 UI 会和源码对不上。

# 编辑器
.vscode/
.idea/

# 开发过程中的会话导出、临时诊断输出等，不属于项目内容
*-virustotalwindowspe.txt
